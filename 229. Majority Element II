class Solution {
    public List<Integer> majorityElement(int[] nums) {
        int ele1=Integer.MIN_VALUE;
        int ele2=Integer.MAX_VALUE;
        int c1=0,c2=0;
int n=nums.length;
        for(int i=0;i<n;i++){
            if(ele1==nums[i]){
                c1++;
            }
            else if(ele2==nums[i]){
                c2++;
            }
            else if(c1==0){
                c1++;
                ele1=nums[i];
            }
            else if(c2==0){
                c2++;
                ele2=nums[i];
            }
            else{
                c1--;
                c2--;
            }
        }
         c1=0; c2=0;
        for(int i=0;i<n;i++){
           if(nums[i]==ele1){
            c1++;
           }
        }
        for(int i=0;i<n;i++){
            if(nums[i]==ele2){
                c2++;
            }

        }
        List<Integer> list=new ArrayList<>();
        if(c1>n/3)  list.add(ele1);
        
        if(c2>n/3) list.add(ele2);
      return list;
    }
}
