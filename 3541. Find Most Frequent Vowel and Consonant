class Solution {
    public int maxFreqSum(String s) {
        int[] freq = new int[26];
        int max = 0;
        int min = 0;
        for (int i = 0; i < s.length(); i++) {
            char ch = s.charAt(i);
            freq[ch - 'a']++;
            if (ch == 'a' || ch == 'e' || ch == 'i' || ch == 'o' || ch == 'u') {
                max = Math.max(max, freq[ch - 'a']);
            } else {
                min = Math.max(min, freq[ch - 'a']);
            }

        }
        return min + max;
    }
}
