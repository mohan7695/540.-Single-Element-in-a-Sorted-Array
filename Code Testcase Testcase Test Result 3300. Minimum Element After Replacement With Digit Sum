class Solution {
    public int minElement(int[] nums) {
        int max=Integer.MAX_VALUE;
        
        for(int i=0;i<nums.length;i++){
            int num=nums[i];
              int sum=0; 
            while(num>0){
             
                int d=num%10;
                sum=d+sum;
                num=num/10;


             } max=Math.min(max,sum);
            
        }
        return max;
    }
}
