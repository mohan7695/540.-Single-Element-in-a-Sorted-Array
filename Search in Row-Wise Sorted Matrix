import java.util.ArrayList;

class Solution {
    // Binary search helper function for a single row
    public boolean search(int[] arr, int x) {
        int low = 0;
        int high = arr.length - 1; // Fixed to avoid OutOfBoundsException

        while (low <= high) {
            int mid = low + (high - low) / 2; // Fixed syntax error

            if (arr[mid] == x) {
                return true;
            } else if (arr[mid] > x) {
                high = mid - 1;
            } else {
                low = mid + 1;
            }
        }
        return false;
    }

    // Function to search a given number in a row-column sorted matrix
    public boolean searchRowMatrix(int[][] mat, int x) {
        for (int i = 0; i < mat.length; i++) {
            if (search(mat[i], x)) {
                return true;
            }
        }
        return false;
    }
}
