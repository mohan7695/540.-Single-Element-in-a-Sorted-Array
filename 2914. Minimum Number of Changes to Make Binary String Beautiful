class Solution {
    public int minChanges(String s) {
        int count = 0;

        for (int i = 0; i < s.length(); i += 2) {
            int ch = (int) s.charAt(i);
            int g = (int) s.charAt(i + 1);

            if (ch != g) {
                count++;
            }
        }
        return count;
    }
}
