class Solution {
    public List<Integer> findDuplicates(int[] nums) {
        ArrayList<Integer> list = new ArrayList<>();
        HashMap<Integer, Integer> map = new HashMap<>();

        for (int n : nums) {
            if (map.containsKey(n)) {

                list.add(n);
            } else {
                map.put(n, 0 + 1);
            }
        }
        return list;
    }
}
