class Solution {
    public int findKthPositive(int[] arr, int k) {
        int left = 0;
        int right = arr.length-1;
        int total = arr.length + k;

        while (left <= right) {
            int mid = (left + right) / 2;
            if (arr[mid] > mid + k) {
                total = mid + k;
                right = mid - 1;
            } else {
                left = mid + 1;
            }
        }
        return total;
    }
}
