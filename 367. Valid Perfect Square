class Solution {
    public boolean isPerfectSquare(int num) {
        if(num == 0 || num ==1) return true;
          long i=1; long r=num;
          
        while(i <= r){

          long mid=(i+r)/2;
          if(mid*mid == num){
            return true;
          }

          else if( mid*mid < num){
            i=mid+1;
          }
          else{
            r=mid-1;
          }
        
        }
        return false;
    }
}
