class Solution {
    public String addSpaces(String s, int[] spaces) {
        int count = 0;
        StringBuilder sb = new StringBuilder();
        for (int i = 0; i < s.length(); i++) {
            char ch = s.charAt(i);

            if (count < spaces.length && i == spaces[count]) {

                sb.append(" ");
               count++;
                sb.append(ch);
            } else {
                sb.append(ch);
            }
        }

        return sb.toString();
    }
}
