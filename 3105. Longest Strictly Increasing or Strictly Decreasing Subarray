class Solution {
    public int longestMonotonicSubarray(int[] nums) {
        int top =1;
        int down =1;
        int max = Integer.MIN_VALUE;
        if(nums.length <=1){
            return nums[0];
        }
        for(int i=1;i<nums.length;i++){
            if(nums[i] > nums[i-1]){
                top++;
                down=1;
            }
           else if(nums[i] < nums[i-1]){
                down++;
                top = 1;
            }
            else{
                top=1;
                down=1;
            }
max = Math.max(top,Math.max(max,down));

        }
        return max;
    }
}
